# ============================================
# SMTP Email Configuration
# ============================================
# Gmail Setup Instructions:
# 1. Enable 2FA: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Copy 16-character password below

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM=noreply@flowerstore.com

# ============================================
# Alternative SMTP Providers
# ============================================
# For Outlook:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587

# For SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.your_sendgrid_api_key

# ============================================
# Supabase Configuration (if needed)
# ============================================
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ============================================
# Stripe Configuration (if implementing payments)
# ============================================
# STRIPE_SECRET_KEY=sk_live_your_stripe_key
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================
# Notes:
# ============================================
# - This is a TEMPLATE file
# - Copy this to .env.local (NEVER commit .env.local)
# - Add your actual credentials
# - Keep SMTP_PASS secret!
# - For development, test SMTP first at /admin/emails
